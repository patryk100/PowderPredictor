# -*- mode: Python -*-

update_settings(k8s_upsert_timeout_secs=120)

# Build operator binary locally for the container OS/ARCH, enabling fast live-updates
local_resource(
    'operator-binary',
    cmd='CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -o bin/manager-linux cmd/main.go',
    deps=['cmd', 'api', 'internal', 'go.mod', 'go.sum'],
    labels=['build'],
)

# Custom build or fast docker build that syncs the compiled binary into the container
docker_build(
    'controller:latest',
    '.',
    dockerfile_contents='''
FROM gcr.io/distroless/static:nonroot
WORKDIR /
COPY bin/manager-linux /manager
USER 65532:65532
ENTRYPOINT ["/manager"]
''',
    only=['bin/manager-linux'],
    live_update=[
        sync('bin/manager-linux', '/manager'),
        restart_container(),
    ],
)

# Apply kubernetes manifests generated by kustomize
k8s_yaml(kustomize('config/default'))

# Apply sample CRs for local validation
k8s_yaml('config/samples/weather_v1alpha1_resorttarget.yaml')

# Track controller manager deployment
k8s_resource(
    'powder-controller-manager',
    labels=['operator'],
)
